# ==============================================================================
# Uttara Platform - Production Environment Variables Example
# Do not commit real credentials to version control.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Database (Neon PostgreSQL with SSL)
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Authentication Secrets (Generate 64+ char random keys for production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cross-Origin Resource Sharing (Production frontend URL)
CORS_ORIGIN=https://oota.yourdomain.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public Frontend API URL (Used by Next.js client)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Storage (Cloudflare R2 - if object storage is enabled)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Push Notifications (Firebase Cloud Messaging - optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
