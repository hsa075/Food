generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  outlet_staff
  outlet_manager
  kitchen_manager
  admin
}

enum OutletStatus {
  OPEN
  BUSY
  CLOSED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  TAKEAWAY
  DINE_IN
}

enum PaymentProvider {
  RAZORPAY
  MOCK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum ProductionStatus {
  PLANNED
  IN_PREPARATION
  READY_FOR_DISPATCH
  DISPATCHED
  COMPLETED
}

enum DispatchStatus {
  DISPATCHED
  RECEIVED
  DISCREPANCY
}

enum LoyaltyTxType {
  EARNED
  REDEEMED
  ADJUSTED
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  phone            String               @unique
  name             String
  passwordHash     String
  role             Role                 @default(customer)
  favoriteOutletId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  refreshTokens    RefreshToken[]
  orders           Order[]
  loyaltyAccount   LoyaltyAccount?
  addresses        Address[]
  notifications    Notification[]
  reviews          Review[]
  staffAssignments StaffOutlet[]

  favoriteOutlet   Outlet?              @relation("UserFavoriteOutlet", fields: [favoriteOutletId], references: [id])

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Outlet {
  id                     String         @id @default(uuid())
  name                   String
  slug                   String         @unique
  code                   String         @unique // e.g. "BLR-IND-01"
  address                String
  locality               String
  landmark               String?
  latitude               Float
  longitude              Float
  phone                  String
  email                  String
  isActive               Boolean        @default(true)
  opensAt                String         @default("11:30")
  closesAt               String         @default("22:30")
  averagePrepTimeMinutes Int            @default(8)
  currentStatus          OutletStatus   @default(OPEN)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  orders                 Order[]
  dailyMenus             DailyMenu[]
  staffAssignments       StaffOutlet[]
  dispatches             KitchenOutletDispatch[]
  reviews                Review[]
  favoriteByUsers        User[]         @relation("UserFavoriteOutlet")

  @@index([locality])
  @@index([isActive])
}

model StaffOutlet {
  id        String   @id @default(uuid())
  userId    String
  outletId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([outletId])
}

model MenuItem {
  id            String      @id @default(uuid())
  name          String
  kannadaName   String
  description   String
  basePrice     Float       @default(139.0)
  isDefaultOota Boolean     @default(true)
  imageUrl      String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems    OrderItem[]
}

model DailyMenu {
  id                 String   @id @default(uuid())
  outletId           String?  // null means global default across all outlets
  date               String   // YYYY-MM-DD
  palya1Name         String
  palya1KannadaName  String?
  palya1Description  String
  palya2Name         String
  palya2KannadaName  String?
  palya2Description  String
  specialItem        String?
  overridePrice      Float?
  isAvailable        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  outlet             Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, date])
  @@index([date])
}

model Order {
  id               String       @id @default(uuid())
  orderNumber      String       @unique // e.g. "UTT-1001"
  userId           String?
  outletId         String
  customerName     String
  customerPhone    String
  customerEmail    String?
  status           OrderStatus  @default(PLACED)
  orderType        OrderType    @default(TAKEAWAY)
  pickupOtp        String       // 4-digit code
  notes            String?

  quantity         Int          @default(1)
  unitPrice        Float        @default(139.0)
  subtotal         Float
  discountAmount   Float        @default(0.0)
  packagingFee     Float        @default(15.0)
  taxAmount        Float        // 5% GST
  totalAmount      Float

  couponCode       String?
  estimatedReadyAt DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  outlet           Outlet       @relation(fields: [outletId], references: [id])
  items            OrderItem[]
  payment          Payment?
  loyaltyTransactions LoyaltyTransaction[]
  reviews          Review[]

  @@index([outletId, status])
  @@index([userId])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  menuItemId String?
  name       String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String          @unique
  amount            Float
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(MOCK)
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([providerOrderId])
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  description    String
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Float
  minOrderValue  Float        @default(0)
  maxDiscount    Float?
  usageLimit     Int          @default(1000)
  usageCount     Int          @default(0)
  isActive       Boolean      @default(true)
  validFrom      DateTime     @default(now())
  validUntil     DateTime
  createdAt      DateTime     @default(now())

  @@index([code])
}

model LoyaltyAccount {
  id                   String               @id @default(uuid())
  userId               String               @unique
  pointsBalance        Int                  @default(0)
  lifetimePointsEarned Int                  @default(0)
  tier                 String               @default("ROTTI_LOVER")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               String         @id @default(uuid())
  loyaltyAccountId String
  orderId          String?
  points           Int
  type             LoyaltyTxType  @default(EARNED)
  description      String
  createdAt        DateTime       @default(now())

  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([loyaltyAccountId])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String   @default("Home") // e.g. "Home", "Work"
  addressLine String
  locality    String
  landmark    String?
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KitchenProduction {
  id               String                  @id @default(uuid())
  date             String                  // YYYY-MM-DD
  batchNumber      String                  @unique // e.g. "BATCH-20260920-01"
  plannedMeals     Int
  cookedMeals      Int                     @default(0)
  dispatchedMeals  Int                     @default(0)
  wastageMeals     Int                     @default(0)
  status           ProductionStatus        @default(PLANNED)
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  dispatches       KitchenOutletDispatch[]

  @@index([date])
}

model KitchenOutletDispatch {
  id                  String            @id @default(uuid())
  kitchenProductionId String
  outletId            String
  expectedMeals       Int
  dispatchedMeals     Int               @default(0)
  receivedMeals       Int               @default(0)
  status              DispatchStatus    @default(DISPATCHED)
  discrepancyNotes    String?
  dispatchedAt        DateTime          @default(now())
  receivedAt          DateTime?

  production          KitchenProduction @relation(fields: [kitchenProductionId], references: [id], onDelete: Cascade)
  outlet              Outlet            @relation(fields: [outletId], references: [id])

  @@index([kitchenProductionId])
  @@index([outletId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   @default("ORDER_UPDATE")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  outletId  String
  orderId   String
  rating    Int      // 1 to 5
  comment   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([outletId])
}
